<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish-plugins</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>jellyfish-plugin-plan</artifactId>
    <name>Jellyfish Plugin Plan</name>
    <description>官方 plan 模式插件：按用户声明的只读白名单拦截写类工具，并提供 /plan [on|off] 开关。</description>

    <dependencies>
        <!-- 内核契约：必须 provided —— PF4J 的插件类加载器是子优先，
             插件自带 zcd/jellyfish/api 会遮蔽父加载器的同名类，破坏类型同一性；
             内核的 PluginClasspathGuard 会在加载期直接拒绝这种插件包。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志：与内核同源（宿主已有 slf4j），同样走 provided 由父加载器提供。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 单测：本插件只做「读配置 + 判权限 + 拼文案」——开关状态走内核的会话扩展条目，
             没有自有文件格式，因此不需要自带 Jackson、也不需要 maven-shade-plugin。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 仅测试期使用：插件加载链路的端到端验证需要真实的 PF4J 管理器、注册表与会话域。
             插件本身只依赖 jellyfish-api，绝不可把这一条升为 compile。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
