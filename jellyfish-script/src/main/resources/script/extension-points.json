{
  "_comment": "脚本桥接的扩展点能力档：这是「脚本能用哪些扩展点」的唯一真源。三段的语义不同，不要合并——'in' 是已打通，'planned' 是已决定要做但还没做，'excluded' 是明确不做。内核新增扩展点时，ExtensionPointCoverageTest 会因为「有扩展点没被分类」而失败，逼迫在这里做一次决策。'args' / 'shape' 是两种语言各自的实参构造与结果整形函数的键名（见 jellyfish_sdk.py / jellyfish_sdk.js 的 ARGS / SHAPES 表）。",

  "in": [
    { "class": "ToolCallRequest",              "type": "tool",            "routeKey": true,  "args": "tool",            "shape": "tool" },
    { "class": "CommandRequest",               "type": "command",         "routeKey": true,  "args": "command",         "shape": "command" },
    { "class": "CommandOptionRequest",         "type": "command_options", "routeKey": true,  "args": "command_options", "shape": "choices" },
    { "class": "PromptContributionRequest",    "type": "prompt",          "routeKey": false, "args": "none",            "shape": "text" },
    { "class": "StatusLineContributionRequest","type": "status_line",     "routeKey": false, "args": "none",            "shape": "text" },
    { "class": "PanelContributionRequest",     "type": "panel",           "routeKey": false, "args": "none",            "shape": "panel" },
    { "class": "PermissionCheckRequest",       "type": "permission",      "routeKey": false, "args": "none",            "shape": "permission" },
    { "class": "SessionPersistRequest",        "type": "session_persist", "routeKey": false, "args": "snapshot",        "shape": "nothing" },
    { "class": "SessionRestoreRequest",        "type": "session_restore", "routeKey": false, "args": "none",            "shape": "sessions" },
    { "class": "SessionDeleteRequest",         "type": "session_delete",  "routeKey": false, "args": "session_id",      "shape": "nothing" },
    { "class": "CompactionStrategyRequest",    "type": "compaction",      "routeKey": false, "args": "request",         "shape": "mapping" }
  ],

  "planned": [
    { "class": "ToolResultPostRequest",      "phase": "P1", "reason": "结果整形，数据进数据出、不在热路径，与 Java 插件同权价值高" },
    { "class": "ToolArgumentPreRequest",     "phase": "P1", "reason": "参数改写，同上；注意它排在权限判定之前，协议要先想清楚" },
    { "class": "TurnContextRequest",         "phase": "P1", "reason": "回合上下文，每轮一次但可接受一次进程往返" },
    { "class": "SessionBeforeCloseRequest",  "phase": "P1", "reason": "关闭前落点，低频；脚本做收尾比订阅 SessionClosedEvent 可靠" },
    { "class": "SessionBeforeForkRequest",   "phase": "P1", "reason": "分支前落点，低频，与关闭前同构" },
    { "class": "CompactionPreRequest",       "phase": "P1", "reason": "压缩前询问，低频" },
    { "class": "ModelCatalogRequest",        "phase": "P1", "reason": "模型目录发现，数据进出，脚本能给的是静态列表" },
    { "class": "ToolActivationRequest",      "phase": "P2", "reason": "每次冻结工具清单都问，进请求路径；先定「热路径往返」策略" },
    { "class": "RequestTuningRequest",       "phase": "P2", "reason": "每次组装请求都问，同 ToolActivation" },
    { "class": "AgingStrategyRequest",       "phase": "P2", "reason": "每次处理较早工具结果都问，同 ToolActivation" },
    { "class": "InputTransformRequest",      "phase": "P2", "reason": "用户回车后的提交路径；同 ToolActivation" },
    { "class": "TurnBeforeRequest",          "phase": "P2", "reason": "回合开始前的提交路径；同 ToolActivation" },
    { "class": "InputDirectiveRequest",      "phase": "P2", "reason": "输入指令（! / @）的提交路径；同 ToolActivation" }
  ],

  "excluded": [
    { "class": "ProviderRegistrationRequest",  "reason": "结构上做不到：它要返回一个 LlmTransport Java 对象（带流式回调），不是数据载荷" },
    { "class": "ToolRenderHintRequest",        "reason": "渲染线程内联执行，注释明确「渲染线程一卡，整个界面都不动」；脚本一次进程往返（含冷启动）不可接受" },
    { "class": "InputReferenceRequest",       "reason": "输入框补全，慢实现会直接卡住整个界面；同 ToolRenderHint" },
    { "class": "ShortcutContributionRequest",  "reason": "外壳收集键位表是启动期动作，与「start() 期零进程」的纪律直接冲突" }
  ]
}
