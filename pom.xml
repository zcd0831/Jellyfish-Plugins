<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>zcd</groupId>
    <artifactId>jellyfish-plugins</artifactId>
    <packaging>pom</packaging>
    <version>0.0.1-SNAPSHOT</version>
    <name>Jellyfish Plugins</name>
    <description>官方插件聚合：每个子模块产出一个独立插件 jar，放在 plugins/ 下由 PF4J 加载。</description>

    <!-- 每个 PF4J 插件是「一个 jar 一个 plugin.properties」，因此一个插件一个子模块，
         这里只做聚合与版本继承，不产出任何构件。 -->
    <modules>
        <!-- 跨语言插件运行时：语言无关的机制层，被桥接插件各自 shade，不进内核 classpath -->
        <module>jellyfish-script</module>
        <module>jellyfish-plugin-tools</module>
        <module>jellyfish-plugin-session-file</module>
        <module>jellyfish-plugin-todo</module>
        <module>jellyfish-plugin-project</module>
        <module>jellyfish-plugin-compact</module>
        <!-- 编排插件：声明式 spec 驱动子代理（走内核的委派端口），无第三方依赖 -->
        <module>jellyfish-plugin-workflow</module>
        <!-- skills 插件：目录发现 + 提示词贡献 + 按需加载正文，无第三方依赖 -->
        <module>jellyfish-plugin-skills</module>
        <!-- plan 模式插件：只读白名单 + /plan 开关（权限拦截走类型级扩展点），无第三方依赖 -->
        <module>jellyfish-plugin-plan</module>
        <!-- 资源监控插件：JVM / 磁盘采样全走 JDK 自带的 JMX 与 java.nio，无第三方依赖 -->
        <module>jellyfish-plugin-resmon</module>
        <!-- MCP 客户端插件：stdio 连接外部 server，工具以 mcp__<server>__<tool> 接入 -->
        <module>jellyfish-plugin-mcp</module>
        <!-- 命令行插件：自带 commons-exec（shade 进插件包），内核 classpath 上不出现它 -->
        <module>jellyfish-plugin-shell</module>
        <!-- 跨语言桥接插件：脚本进程由它承载，机制层（jellyfish-script）被 shade 进它的插件包 -->
        <module>jellyfish-plugin-python</module>
        <module>jellyfish-plugin-node</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <jackson.version>2.21.6</jackson.version>
        <commons-exec.version>1.3</commons-exec.version>
        <slf4j.version>1.7.36</slf4j.version>
        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <!-- 打包：shade 3.5.x 是仍支持 JDK 8 + Maven 3.2.5 的版本线 -->
        <maven-shade-plugin.version>3.5.1</maven-shade-plugin.version>

        <!-- 单元测试：JUnit5 + Mockito（Mockito 4.x 是最后一条支持 JDK8 的主线） -->
        <junit.version>5.10.2</junit.version>
        <mockito.version>4.11.0</mockito.version>

        <!-- 覆盖率：JaCoCo 0.8.12 是仍支持 Java 1.8 运行时的最后一个主线 -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson JSON：只保留桥接插件自带并 shade 进插件包的那一份 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Apache Commons Exec：shell 插件与跨语言运行时的进程层 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-exec</artifactId>
                <version>${commons-exec.version}</version>
            </dependency>

            <!-- 日志：宿主已有 slf4j，插件侧一律 provided -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- 单元测试：以 BOM 统一管理 JUnit5 / Mockito 全套构件版本，子模块只声明 GA 不带版本 -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-bom</artifactId>
                <version>${mockito.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 编译：版本与 -parameters 的唯一定义处，子模块无需重复声明 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- 保留构造器参数名（MethodParameters 属性）。
                             这不是「为了调试方便」：jellyfish-api 的扩展点载荷（会话快照等）是
                             「全字段构造器 + 无 setter」的不可变类型，插件侧用 Jackson 反序列化时
                             只能靠构造器参数名把 JSON 字段对上。去掉它，会话持久化插件会在运行时
                             「写得出、读不回」，而编译与大部分单测依然全绿。 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <!-- 打包：插件包私有依赖 shade 的版本唯一定义处，各插件模块自行声明执行 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                </plugin>
                <!-- 覆盖率：版本与执行绑定的唯一定义处，子模块无需重复声明 -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <!-- 纯声明型类不纳入覆盖率统计 -->
                            <exclude>**/package-info.*</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <!-- 在 initialize 阶段挂上 Jacoco agent，保证 surefire 跑测试时被采集 -->
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <!-- 绑定到 test 阶段：mvn test 后即可在 target/site/jacoco/index.html 看到报告 -->
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 声明即生效：所有子模块继承同一份编译配置 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- 声明即生效：所有子模块继承同一份 JaCoCo 配置 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
