<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zcd</groupId>
        <artifactId>jellyfish-plugins</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>jellyfish-plugin-resmon</artifactId>
    <name>Jellyfish Plugin Resmon</name>
    <description>官方资源监控插件：JVM 与磁盘占用采样 + 只读 /resmon 命令 + TUI 常驻面板（纯只读，不做清理）。</description>

    <dependencies>
        <!-- 内核契约：必须 provided —— PF4J 的插件类加载器是子优先，
             插件自带 zcd/jellyfish/api 会遮蔽父加载器的同名类，破坏类型同一性；
             内核的 PluginClasspathGuard 会在加载期直接拒绝这种插件包。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志：与内核同源（宿主已有 slf4j），同样走 provided 由父加载器提供。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 单测：本插件的采样全部走 JDK 自带的 JMX（ManagementFactory）与 java.nio 文件遍历，
             配置段只有扁平标量与字符串、手工解析即可，因此既不需要自带 Jackson、
             也不需要 maven-shade-plugin（shade 只用于把私有第三方依赖打进插件包）。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 仅测试期使用：插件加载链路的端到端验证需要真实的 PF4J 管理器与注册表。
             插件本身只依赖 jellyfish-api，绝不可把这一条升为 compile。 -->
        <dependency>
            <groupId>zcd</groupId>
            <artifactId>jellyfish-infra</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
